generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  iconFileName      String
  password          String
  resetToken        String?
  resetTokenExpires DateTime?
  note              String?
  entered           Boolean   @default(false)
  enteredAt         DateTime?
  exitedAt          DateTime?
  officeId          Int
  office            Office    @relation(fields: [officeId], references: [id])

  @@index([officeId])
}

model Office {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int
  // Discord の在室ボード（Webhook メッセージ）の ID。入退室のたびにこのメッセージを編集する
  discordBoardMessageId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}
