generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  iconFileName      String
  password          String
  resetToken        String?
  resetTokenExpires DateTime?
  note              String?
  entered           Boolean   @default(false)
  enteredAt         DateTime?
  exitedAt          DateTime?
  /// ビーコンの圏外になった時刻。猶予（EXIT_GRACE_MINUTES）の間に戻らなければ退室を確定する
  exitPendingSince  DateTime?
  /// ビーコンの圏内になった時刻。確認の時間（ENTER_CONFIRM_MINUTES）の間に圏外にならなければ入室を確定する
  enterPendingSince DateTime?
  officeId          Int
  office            Office    @relation(fields: [officeId], references: [id])

  @@index([officeId])
}

model Office {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}
