# ローカル開発用の環境変数の見本。.env にコピーして値を入れる（.env は git に入らない）
#   cp .env.example .env
# 本番の値は Vercel の Environment Variables にある。本番の値をローカルに置かないこと
# （prisma migrate dev などが本番の DB を書き換えてしまう）。

# --- DB（必須） ---
# docker compose up -d で起動するローカルの Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/office_manager

# --- ログイン（必須） ---
# ログイン用トークン（JWT）の署名鍵。ローカルは適当な長い文字列でよい（本番とは別の値にする）
#   例: openssl rand -hex 32
JWT_SECRET=

# --- 定期実行（cron-job.org から呼ぶ API） ---
# Authorization: Bearer <この値> で呼ぶ。ローカルで試すなら適当な値
CRON_SECRET=

# --- Discord への通知 ---
# オフィスごとの Webhook（DISCORD_WEBHOOK_URL_<オフィスのコード>）。ないオフィスは DEFAULT に送る
# ローカルで本番のチャンネルに流さないよう、空のままにしておく
DISCORD_WEBHOOK_URL_DEFAULT=
DISCORD_WEBHOOK_URL_OKAYAMA=
DISCORD_WEBHOOK_URL_TOKYO=

# --- プロフィール画像（Cloudflare R2）---
# 空なら public/icons に保存する（ローカル開発用。本番では R2 が必須）
R2_PUBLIC_URL=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto

# --- パスワード再設定メール ---
# 再設定ページの URL の先頭（例: http://localhost:3000）
NEXT_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
